# Copy this file to .env and fill in your own keys. Never commit .env.

# Current weather (https://openweathermap.org/api). Without it, Open-Meteo is used.
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Agriculture Assistant (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
# Optional: a different Groq model
# GROQ_MODEL=openai/gpt-oss-120b

# Live farmer news needs no API key: it reads publishers' public RSS feeds.
# Optional: replace the default feeds. Entries are "Publisher|feed URL|all", separated
# by ";". "all" keeps every item (an agriculture-only feed); without it, items are
# filtered by farmer keywords.
# NEWS_FEEDS=The Economic Times|https://economictimes.indiatimes.com/news/economy/agriculture/rssfeeds/1202099874.cms|all
